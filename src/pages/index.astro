<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>ХуторОК</title>
		<style>
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
				gap: 20px;
				padding: 20px;
			}
			.card {
				border: 1px solid #ccc;
				padding: 15px;
				text-align: center;
				border-radius: 8px;
			}
			button {
				background: #25d366;
				color: white;
				border: none;
				padding: 10px;
				cursor: pointer;
				border-radius: 5px;
			}
		</style>
	</head>
	<body>
		<h1>ХуторОК</h1>
		<p>вулиця Вірменська, 29, Київ, 02121</p>
		<iframe
			src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d3801.0285631153574!2d30.66798727918125!3d50.40849299094762!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x40d4c5004a3102c1%3A0x8d1fdd5735b7128e!2z0L_RgNC-0LTRg9C60YLQvtCy0LjQuSDQvNCw0LPQsNC30LjQvSAi0KXRg9GC0L7RgNCe0Joi!5e0!3m2!1suk!2sua!4v1767275834305!5m2!1suk!2sua"
